<Page
    x:Class="Distill.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Distill.App.ViewModels"
    xmlns:converters="using:Distill.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </Page.Resources>

    <NavigationView x:Name="MainNavView"
                    PaneTitle="Distill"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="LeftCompact"
                    ItemInvoked="MainNavView_ItemInvoked"
                    Loaded="MainNavView_Loaded">
        
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavQueue" Content="Distill Queue" Tag="Queue" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FD;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            
            <NavigationViewItem x:Name="NavSettings" Content="Settings" Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28,20,28,20">
            
            <!-- 1. QUEUE & INGEST VIEW -->
            <Grid x:Name="QueueViewPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Ingest Card -->
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Extract Instagram Knowledge" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Paste any Instagram Reel or Carousel URL to extract speech, OCR visuals, and create notes in Obsidian."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     x:Name="UrlInputBox"
                                     PlaceholderText="Paste Instagram link (e.g. https://www.instagram.com/reel/... or /p/...)"
                                     Text="{x:Bind ViewModel.InstagramUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="UrlInputBox_KeyDown"
                                     VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="⚡ Add to Queue"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.AddJobCommand}"
                                    Padding="20,7"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Queue Header -->
                <Grid Grid.Row="1" Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Active Queue" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Clear Completed"
                            Command="{x:Bind ViewModel.ClearCompletedCommand}"
                            Visibility="{x:Bind ViewModel.HasJobs, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                            Padding="12,4"/>
                </Grid>

                <!-- Empty State -->
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.HasNoJobs, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                    <FontIcon Glyph="&#xE8FD;" FontSize="42" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="No active jobs in queue" FontSize="16" FontWeight="Medium"
                               HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Paste an Instagram Reel or Carousel URL above to begin distillation."
                               FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Jobs ListView -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
                          SelectionMode="None"
                          Visibility="{x:Bind ViewModel.HasJobs, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                          Padding="0,0,0,20">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,12"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PipelineJobItemViewModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <!-- Top Row: Status Pill, Title, URL -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Badge Pill -->
                                        <Border Grid.Column="0"
                                                Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}"
                                                CornerRadius="12"
                                                Padding="10,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusBadgeText, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>

                                        <!-- Title / URL -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Url, Mode=OneWay}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Status Message & Progress -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="12"/>

                                        <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                     IsIndeterminate="{x:Bind IsActive, Mode=OneWay}"
                                                     Visibility="{x:Bind IsDone, Mode=OneWay, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"
                                                     Height="4"
                                                     CornerRadius="2"/>
                                    </StackPanel>

                                    <!-- Error Callout if Failed -->
                                    <InfoBar IsOpen="{x:Bind IsFailed, Mode=OneWay}"
                                             Severity="Error"
                                             Title="Processing Error"
                                             Message="{x:Bind ErrorMessage, Mode=OneWay}"
                                             IsClosable="False"/>

                                    <!-- Actions when Done -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="{x:Bind IsDone, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                        <Button Content="📝 Open in Obsidian"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Command="{x:Bind OpenInObsidianCommand}"
                                                Padding="14,6"/>

                                        <Button Content="📁 View File"
                                                Command="{x:Bind OpenFileCommand}"
                                                Padding="14,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 2. ENHANCED SETTINGS VIEW -->
            <ScrollViewer x:Name="SettingsViewPanel" Visibility="Collapsed">
                <StackPanel Spacing="24" MaxWidth="820" HorizontalAlignment="Left" Padding="0,0,0,40">
                    
                    <!-- Header -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Settings &amp; Diagnostics" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Manage local AI engines, speech transcriber models, Obsidian vault, and pipeline preferences."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                    </StackPanel>

                    <!-- Saved Notification -->
                    <InfoBar IsOpen="{x:Bind ViewModel.IsSettingsSavedVisible, Mode=OneWay}"
                             Severity="Success"
                             Title="Settings Saved"
                             Message="Configuration updated successfully and saved to appsettings.json."
                             IsClosable="True"/>

                    <!-- CARD 1: SYSTEM HEALTH & LOCAL TOOLS -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="System Health &amp; Local Tools" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind ViewModel.HealthStatusMessage, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="🔄 Refresh"
                                            Command="{x:Bind ViewModel.RefreshHealthReportCommand}"
                                            Padding="12,4"/>
                                    <Button Content="⚡ Download / Update Tools"
                                            Command="{x:Bind ViewModel.DownloadMissingToolsCommand}"
                                            Padding="12,4"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tool Status Rows -->
                            <StackPanel Spacing="10">
                                <!-- yt-dlp -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="yt-dlp (Downloader)" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HealthReport.YtDlp.Details, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ffmpeg -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ffmpeg (Audio &amp; Frames)" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HealthReport.Ffmpeg.Details, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- whisper.cpp -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="whisper.cpp (Speech-to-Text)" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HealthReport.Whisper.Details, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Windows Native OCR -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Windows OCR Engine" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HealthReport.WindowsOcr.Details, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Tool Update Progress -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsUpdatingTools, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <ProgressBar IsIndeterminate="True" Height="4"/>
                                <TextBlock Text="{x:Bind ViewModel.ToolsUpdateStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: OBSIDIAN VAULT DESTINATION -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Obsidian Vault Destination" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="The directory or subfolder inside your Obsidian vault where distilled Markdown notes will be written."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Header="Vault Folder Path"
                                         PlaceholderText="e.g. C:\Users\Username\Documents\ObsidianVault\Instagram"
                                         Text="{x:Bind ViewModel.VaultFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1"
                                        Content="📁 Browse Folder..."
                                        Click="BrowseVaultFolder_Click"
                                        VerticalAlignment="Bottom"
                                        Padding="16,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: OLLAMA LOCAL LLM SYNTHESIS -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Ollama Local LLM Synthesis" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Local AI inference used to deduplicate visual OCR and audio transcripts into structured Obsidian notes."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </StackPanel>

                                <!-- Live Connection Indicator -->
                                <Border Grid.Column="1"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.OllamaStatusText, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Header="Ollama Endpoint URL"
                                         PlaceholderText="http://localhost:11434"
                                         Text="{x:Bind ViewModel.OllamaEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1"
                                        Content="🔄 Refresh Models"
                                        Command="{x:Bind ViewModel.RefreshOllamaModelsCommand}"
                                        VerticalAlignment="Bottom"
                                        Padding="16,6"/>
                            </Grid>

                            <ComboBox Header="Ollama Model Name"
                                      PlaceholderText="Select or type model name (e.g. llama3.2:3b, qwen2.5:7b)"
                                      IsEditable="True"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.InstalledOllamaModels, Mode=OneWay}"
                                      Text="{x:Bind ViewModel.OllamaModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: WHISPER.CPP SPEECH-TO-TEXT -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Whisper.cpp Speech-to-Text" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Local offline audio transcription for Instagram Reels using whisper.cpp."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>

                            <!-- Model Selector & Actions -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Header="Whisper Model Path / Preset"
                                          PlaceholderText="models/ggml-base.en.bin"
                                          IsEditable="True"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.PresetWhisperModels, Mode=OneWay}"
                                          Text="{x:Bind ViewModel.WhisperModelPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="1"
                                        Content="⬇ Download Model"
                                        Command="{x:Bind ViewModel.DownloadWhisperModelCommand}"
                                        VerticalAlignment="Bottom"
                                        Padding="14,6"/>

                                <Button Grid.Column="2"
                                        Content="📁 Browse .bin"
                                        Click="BrowseWhisperModel_Click"
                                        VerticalAlignment="Bottom"
                                        Padding="14,6"/>
                            </Grid>

                            <!-- Model Download Progress -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsDownloadingWhisperModel, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                                <ProgressBar Value="{x:Bind ViewModel.WhisperDownloadProgress, Mode=OneWay}" Height="6" CornerRadius="3"/>
                                <TextBlock Text="{x:Bind ViewModel.WhisperDownloadStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Header="CPU Threads"
                                         PlaceholderText="4"
                                         Text="{x:Bind ViewModel.WhisperThreadCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBox Grid.Column="1"
                                         Header="Language Hint"
                                         PlaceholderText="en (or auto)"
                                         Text="{x:Bind ViewModel.WhisperLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 5: PIPELINE & AUTOMATION PREFERENCES -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Pipeline &amp; Automation Preferences" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Fine-tune background ingestion behavior, scene detection, and note formatting."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>

                            <!-- Auto-Open Toggle -->
                            <ToggleSwitch Header="Auto-open note in Obsidian upon completion"
                                          OffContent="Disabled"
                                          OnContent="Enabled"
                                          IsOn="{x:Bind ViewModel.AutoOpenInObsidian, Mode=TwoWay}"/>

                            <!-- Append Raw Details Toggle -->
                            <ToggleSwitch Header="Append raw transcript &amp; OCR text in note footer"
                                          OffContent="Disabled"
                                          OnContent="Enabled"
                                          IsOn="{x:Bind ViewModel.AppendRawContentToNote, Mode=TwoWay}"/>

                            <!-- Max Parallel Jobs -->
                            <TextBox Header="Max Concurrent Ingestion Jobs"
                                     PlaceholderText="2"
                                     Text="{x:Bind ViewModel.MaxConcurrentJobs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Scene Detection Sensitivity Slider -->
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Scene-Change Detection Sensitivity" FontWeight="Medium" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SceneChangeThreshold, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </Grid>
                                <Slider Minimum="0.1" Maximum="0.9" StepFrequency="0.05"
                                        Value="{x:Bind ViewModel.SceneChangeThreshold, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Save Action Bar -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="💾 Save Settings"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveSettingsCommand}"
                                Padding="28,9"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </NavigationView>
</Page>
